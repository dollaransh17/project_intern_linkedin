# Required for LLM extraction. Create a Groq API key and never commit it.
GROQ_API_KEY=

# Optional settings
GROQ_MODEL=openai/gpt-oss-20b
CRAWL_TIMEOUT_MS=20000
MAX_SUBPAGES=1
MAX_PAGE_CHARS=2000
MAX_CONTEXT_CHARS=6000

# Optional token-cost estimates. Supply your model's current USD price per million tokens.
GROQ_INPUT_USD_PER_MILLION_TOKENS=
GROQ_OUTPUT_USD_PER_MILLION_TOKENS=
